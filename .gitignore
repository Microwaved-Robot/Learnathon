# Unity Git Ignore for GitHub + Git LFS
# Place at root of project

# ==================
# Unity generated
# ==================
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
*.log
sysinfo.txt
*.pidb
*.pdb
*.mdb
*.opendb
*.VC.db
mono_crash.*

# Crashlytics / memory captures
/[Mm]emoryCaptures/
/[Rr]ecordings/
crashlytics-build.properties

# ==================
# Auto-generated IDE files
# ==================
.vs/
.idea/
*.suo
*.user
*.userprefs
*.csproj
*.unityproj
*.sln
*.booproj
*.svd
*.pidb.meta
*.pdb.meta
*.mdb.meta
*.DotSettings.user

# ==================
# Builds
# ==================
*.apk
*.aab
*.app
*.unitypackage
*.unitypackage.meta

# Optional additional build folders
Builds/
ExportedBuilds/

# ==================
# Addressables / Visual Scripting
# ==================
/[Aa]ssets/AddressableAssetsData/*/*.bin*
/[Aa]ssets/Addressables_Temp*
/[Aa]ssets/Unity.VisualScripting.Generated/

# Auto-generated scenes by play mode tests
/[Aa]ssets/[Ii]nit[Tt]est[Ss]cene*.unity*

# ==================
# Blender and 3D caches
# ==================
*.blend1
*.blend1.meta
/Library/PackageCache/

# ==================
# Git LFS / large assets (track these instead of committing normally)
# ==================
# Uncomment these if using Git LFS
# *.png
# *.jpg
# *.tga
# *.psd
# *.fbx
# *.wav
# *.mp3
# *.ogg
# *.aiff
# *.anim

# ==================
# OS generated
# ==================
.DS_Store
Thumbs.db
